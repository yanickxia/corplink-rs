# Maintainer: PinkD <443657547@qq.com>

pkgname=corplink-rs
_pkgbase=corplink-rs
pkgver=6.6.0
pkgrel=1
pkgdesc='Corplink client written in Rust'
arch=('i686' 'x86_64')
url='https://github.com/yanickxia/corplink-rs'
license=('GPL-2.0-only')
makedepends=('cargo' 'go' 'clang' 'git')
source=(
  "$pkgname.$pkgver.tar.gz"::"https://github.com/yanickxia/corplink-rs/archive/refs/tags/bytedance-$pkgver.tar.gz"
  "wireguard-go"::"git+https://github.com/yanickxia/wireguard-go#commit=a73b9f07989a647ad7f4d84184efb3b1b8ea77a4"
)

# use SKIP to avoid update PKGBUILD everytime
sha256sums=(
  'SKIP'
  'SKIP'
)
backup=(etc/corplink/config.json)

build() {
  # build libwg
  cd "$srcdir/wireguard-go"
  make libwg
  cp libwg.* "$srcdir/$_pkgbase-bytedance-$pkgver/libwg/"

  # build corplink-rs
  cd "$srcdir/$_pkgbase-bytedance-$pkgver"
  cargo build --locked --release
}

package() {
  cd "$srcdir/$_pkgbase-bytedance-$pkgver"
  install -Dm 755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm 600 "config/config.json" "$pkgdir/etc/corplink/config.json"
  install -Dm 644 "systemd/$pkgname.service" "$pkgdir/usr/lib/systemd/system/$pkgname.service"
  install -Dm 644 "systemd/$pkgname@.service" "$pkgdir/usr/lib/systemd/system/$pkgname@.service"
}
